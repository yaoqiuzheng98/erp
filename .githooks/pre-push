#!/bin/sh
# 拦截 main 直接快进到 test 顶点（fast-forward 时 pre-merge-commit 不会执行）。
# 一次性启用：git config core.hooksPath .githooks
test_tip=$(git rev-parse --verify --quiet refs/heads/test 2>/dev/null || true)
[ -n "$test_tip" ] || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  if [ "$local_sha" = "$test_tip" ]; then
    echo "ERROR: main 当前指向 test 的最新提交；禁止把 test 直接快进到 main。" >&2
    exit 1
  fi
done
exit 0
